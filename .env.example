# ---------------------------------------------
# Soundtec - variables de entorno (.env.example)
# Copiá este archivo como .env y completá los valores.
# ---------------------------------------------

# Base de datos PostgreSQL (Neon / Supabase / Render / local)
DATABASE_URL="postgresql://user:password@localhost:5432/soundtec?schema=public"

# Auth.js
# Generá un secreto con: openssl rand -base64 32
AUTH_SECRET="cambiar-por-un-secreto-fuerte"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Admin inicial (usado por el seed)
SEED_ADMIN_EMAIL="admin@soundtec.com.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave-fuerte"
SEED_ADMIN_NAME="Administrador Soundtec"

# OpenAI (Fase 2 - dejar vacío usa mocks)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Serper (búsqueda de imágenes/web)
SERPER_API_KEY=""

# Copiloto de cotizaciones (opcional; también en /admin/api-keys)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Vercel Blob (imágenes y archivos de COT)
# BLOB_READ_WRITE_TOKEN=""

# Configuración general
APP_NAME="Soundtec"
APP_URL="http://localhost:3000"
DEFAULT_CURRENCY="USD"
DEFAULT_GLOBAL_MARGIN_PERCENT="35"
