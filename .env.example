# ---------------------------------------------
# Soundtec - variables de entorno (.env.example)
# Copiá este archivo como .env y completá los valores.
# ---------------------------------------------

# Base de datos PostgreSQL (Neon / Supabase / Render / local)
# En serverless usá el pooler (Neon/Supabase) y un tope de conexiones, p.ej:
# postgresql://user:password@host/soundtec?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://user:password@localhost:5432/soundtec?schema=public"

# Auth.js
# Generá un secreto con: openssl rand -base64 32
AUTH_SECRET="cambiar-por-un-secreto-fuerte"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Cifrado de API keys guardadas en AdminSetting (si falta, se usa AUTH_SECRET)
SETTINGS_ENCRYPTION_KEY="cambiar-por-otro-secreto-de-32-chars-min"

# Setup inicial (deshabilitado en producción salvo ALLOW_SETUP=true)
SETUP_TOKEN=""
ALLOW_SETUP="false"

# Admin inicial (usado por el seed / setup)
SEED_ADMIN_EMAIL="admin@soundtec.com.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave-fuerte"
SEED_ADMIN_NAME="Administrador Soundtec"

# OpenAI (Fase 2 - dejar vacío usa mocks)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Serper (búsqueda de imágenes/web)
SERPER_API_KEY=""

# Copiloto de cotizaciones (opcional; también en /admin/api-keys)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Vercel Blob (imágenes y archivos de COT)
# BLOB_READ_WRITE_TOKEN=""

# Configuración general
APP_NAME="Soundtec"
APP_URL="http://localhost:3000"
DEFAULT_CURRENCY="USD"
DEFAULT_GLOBAL_MARGIN_PERCENT="35"

# Vercel Cron must send this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET="genera-un-secreto-largo-aleatorio"
