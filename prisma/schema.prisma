// Soundtec S.R.L. - Esquema de base de datos
// Provider: PostgreSQL (Neon / Supabase / Render compatible)
// Las tablas cubren Fase 1, 2 y 3 para evitar migraciones rompedoras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------
// AUTH / USUARIOS
// ---------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum AccountMovementKind {
  DEBIT
  CREDIT
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole @default(CLIENT)
  customRoleId    String?
  customRole      CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  companyName     String?
  phone           String?
  isActive        Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Empresa/cliente comercial (usuarios de portal)
  clientId        String?
  client          Client?  @relation("ClientPortalUsers", fields: [clientId], references: [id], onDelete: SetNull)
  wishlists       Wishlist[]
  requests        CustomerRequest[]
  requestMessages RequestMessage[]
  tickets         DeveloperTicket[]
  aiFeedback      AiContentFeedback[]
  quoteSignName   String?
  quoteSignTitle  String?
  ownedQuotes     Quote[]           @relation("QuoteOwner")
  issuedQuotes    Quote[]           @relation("QuoteIssuer")
  quoteAiRuns     QuoteAiRun[]
  quoteRevisions  QuoteRevision[]
  @@index([email])
  @@index([role])
  @@index([customRoleId])
  @@index([clientId])
}

model CustomRole {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  baseSystemRole UserRole @default(CLIENT)
  permissionsJson Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
}

/// Cliente comercial (empresa). No es lo mismo que User: un Client puede tener varios usuarios de portal.
model Client {
  id                  String   @id @default(cuid())
  companyName         String
  tradeName           String?
  contactName         String?
  email               String?
  phone               String?
  taxId               String?
  address             String?
  notes               String?
  assignedPriceListId String?
  assignedPriceList   PriceList? @relation(fields: [assignedPriceListId], references: [id], onDelete: SetNull)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  portalUsers       User[]            @relation("ClientPortalUsers")
  visibilityRules   VisibilityRule[]
  marginRules       MarginRule[]      @relation("ClientMargins")
  discountRules     DiscountRule[]    @relation("ClientDiscounts")
  accountMovements    AccountMovement[]
  requests            CustomerRequest[]
  shareablePriceLists ShareablePriceList[]
  quotes              Quote[]

  @@index([companyName])
  @@index([isActive])
}

// ---------------------------------------------
// CATÁLOGO
// ---------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  priceLists PriceList[]
  mappings   ColumnMappingProfile[]
  imports    ImportBatch[]
}

model Distributor {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  contactInfo Json?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  priceLists PriceList[]
  mappings   ColumnMappingProfile[]
  imports    ImportBatch[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryParent")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductFamily {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_REQUEST
  UNKNOWN
}

enum ProductKind {
  PRINCIPAL
  ACCESORIO
}

model Product {
  id                      String   @id @default(cuid())
  internalSku             String?  @unique
  supplierSku             String?
  normalizedName          String
  originalName            String
  brandId                 String?
  brand                   Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  distributorId           String?
  distributor             Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  categoryId              String?
  category                Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  familyId                String?
  family                  ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  shortDescription        String?
  longDescription         String?
  htmlContent             String?               // HTML largo enriquecido desde fuente externa
  aiGeneratedDescription  Boolean  @default(false)
  aiDescriptionFeedbackStatus String? // "PENDING" | "APPROVED" | "REJECTED"

  // Enriquecimiento desde portales de proveedores (Sonance, etc.)
  specifications          Json?                 // [{label, labelEs?, value, valueEs?, group?}]
  documents               Json?                 // [{name, nameEs?, url, type, fileType?}]
  sourceMetadata          Json?                 // datos raw del portal (debug/refresh)
  enrichedAt              DateTime?             // última vez que se enriqueció con datos completos
  translatedAt            DateTime?             // última vez que se tradujeron campos al ES

  // Identificación alternativa (cualquier vendor puede usarlos)
  modelNumber             String?               // ej. "AMP-X300"
  manufacturerItem        String?               // SKU del fabricante (puede diferir del supplierSku)
  productLine             String?               // línea de producto del proveedor

  // URLs / SEO
  vendorProductUrl        String?               // URL a la página del producto en el portal del proveedor
  urlSlug                 String?               // slug que usa el proveedor (ej. "sa68")
  metaTitle               String?
  metaDescription         String?
  metaKeywords            String?
  videoUrl                String?

  // Sale info
  salePriceUsd            Decimal? @db.Decimal(14, 4)
  salePriceStartsAt       DateTime?
  salePriceEndsAt         DateTime?
  salePriceLabel          String?

  // Availability
  availabilityMessage     String?
  availabilityType        String?               // ej. "INSTOCK" | "BACKORDER" | "OUTOFSTOCK"

  // Dimensiones físicas
  widthCm                 Decimal? @db.Decimal(10, 2)
  heightCm                Decimal? @db.Decimal(10, 2)
  depthCm                 Decimal? @db.Decimal(10, 2)

  // Flags extra
  requiresQuote           Boolean  @default(false)

  // Badges (NEW / ON SALE / FEATURED / etc.)
  badges                  Json?                 // [{name, type?}]

  baseCostUsd             Decimal  @db.Decimal(14, 4)
  currency                String   @default("USD")

  // Clasificación libre (texto)
  familia                 String?
  tipo                    String?

  // Posición arancelaria (NCM / partida)
  tariffPosition          String?
  tariffDutyPercent       Decimal? @db.Decimal(6, 3)  // DIE %
  aecPercent              Decimal? @db.Decimal(6, 3)  // AEC %
  tePercent               Decimal? @db.Decimal(6, 3)  // TE %

  // Logística
  coo                     String?                     // país de origen
  weight                  Decimal? @db.Decimal(10, 3) // kg
  volume                  Decimal? @db.Decimal(10, 4) // m³

  stockStatus             StockStatus @default(UNKNOWN)
  stockQuantity           Int?

  discountPercent         Decimal? @db.Decimal(6, 3)

  // Cadena de importación FOB → NAC
  // COSTO NAC USD  = baseCostUsd × coefNac
  // PRECIO NAC     = costoNacUsd × coefVta × (1 - discountPercent/100)
  // PRECIO NAC FINAL = precioNac × (1 + ivaPercent/100) × (1 + impIntPercent/100)
  // PRECIO VTA FOB = baseCostUsd × coefVtaFob
  coefNac                 Decimal? @db.Decimal(8, 4)  // coef. nacionalización
  coefVta                 Decimal? @db.Decimal(8, 4)  // coef. venta nacional
  ivaPercent              Decimal? @db.Decimal(5, 2)  // IVA % (default 21)
  impIntPercent           Decimal? @db.Decimal(5, 2)  // Impuesto interno %
  coefVtaFob              Decimal? @db.Decimal(8, 4)  // coef. venta FOB

  isCustomizable          Boolean  @default(false)
  isCrestronHomeCompatible Boolean @default(false)
  kind                    ProductKind @default(PRINCIPAL)
  accessoryRequiredWithPrimary Boolean @default(false)
  isActive                Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  images          ProductImage[]
  options         ProductOption[]
  wishlistItems   WishlistItem[]
  requestItems    CustomerRequestItem[]
  marginRules     MarginRule[]
  discountRules   DiscountRule[]
  visibilityRules VisibilityRule[]
  rawImports      RawImportedProduct[]
  accessories     AccessoryRelation[] @relation("AccessorySource")
  accessoryFor    AccessoryRelation[] @relation("AccessoryTarget")
  taxonomySuggestions TaxonomySuggestion[]
  labels          ProductLabel[]
  quoteItems      QuoteItem[]

  @@index([normalizedName])
  @@index([brandId])
  @@index([categoryId])
  @@index([distributorId])
  @@index([isActive])
}

enum ProductRelationKind {
  ACCESSORY       // Accesorio compatible (mount, bracket, requerido por instalación)
  CROSS_SELL      // Producto alternativo o complementario sugerido (otra línea)
  ALSO_PURCHASED  // "Otros también compraron" (upsell del cart)
}

model AccessoryRelation {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation("AccessorySource", fields: [productId], references: [id], onDelete: Cascade)
  accessoryProductId String
  accessoryProduct  Product  @relation("AccessoryTarget", fields: [accessoryProductId], references: [id], onDelete: Cascade)
  isRequired        Boolean  @default(false)
  kind              ProductRelationKind @default(ACCESSORY)
  createdAt         DateTime @default(now())

  @@unique([productId, accessoryProductId, kind])
  @@index([productId])
  @@index([accessoryProductId])
  @@index([kind])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  source     String? // "upload" | "serper" | "supplier" | "scraper"
  isPrimary  Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductOption {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  type          String   // "select" | "boolean" | "number" | "text"
  values        Json
  priceDeltaUsd Decimal? @db.Decimal(14, 4)
  isRequired    Boolean  @default(false)
  sortOrder     Int      @default(0)

  @@index([productId])
}

// ---------------------------------------------
// LISTAS DE PRECIO E IMPORTACIONES
// ---------------------------------------------

enum PriceListSourceType {
  EXCEL
  SCRAPER
  MANUAL
  API
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ShareablePriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Lista de precios curada con filtros y link público único (/lista/{shareSlug}).
model ShareablePriceList {
  id          String                   @id @default(cuid())
  name        String
  description String?
  shareSlug   String                   @unique
  status      ShareablePriceListStatus @default(DRAFT)
  filters     Json
  clientId    String?
  client      Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  showSku     Boolean                  @default(true)
  showStock   Boolean                  @default(false)
  hidePrices  Boolean                  @default(false)
  expiresAt   DateTime?
  viewCount   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([shareSlug])
  @@index([status])
  @@index([clientId])
}

model PriceList {
  id              String              @id @default(cuid())
  name            String
  distributorId   String?
  distributor     Distributor?        @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  brandId         String?
  brand           Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  currency        String              @default("USD")
  sourceType      PriceListSourceType @default(MANUAL)
  uploadedFileUrl String?
  status          PriceListStatus     @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  imports        ImportBatch[]
  clients        Client[]
}

enum ImportBatchStatus {
  PENDING
  MAPPING
  REVIEWING
  COMPLETED
  FAILED
  CANCELLED
}

model ImportBatch {
  id            String            @id @default(cuid())
  priceListId   String?
  priceList     PriceList?        @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  distributorId String?
  distributor   Distributor?      @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  fileName      String
  fileUrl       String?
  status        ImportBatchStatus @default(PENDING)
  totalRows     Int               @default(0)
  processedRows Int               @default(0)
  errorRows     Int               @default(0)
  notes         String?
  detectedHeaders Json?
  appliedMappingJson Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  rawProducts RawImportedProduct[]
}

model ColumnMappingProfile {
  id            String   @id @default(cuid())
  name          String
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sourceType    PriceListSourceType @default(EXCEL)
  mappingJson   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

model RawImportedProduct {
  id                 String          @id @default(cuid())
  importBatchId      String
  importBatch        ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rawJson            Json
  suggestedMappingJson Json?
  normalizedJson     Json?
  approvalStatus     ApprovalStatus  @default(PENDING)
  errorMessage       String?
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([importBatchId])
  @@index([approvalStatus])
}

// ---------------------------------------------
// MOTOR DE PRECIOS: márgenes, descuentos, visibilidad
// ---------------------------------------------

enum RuleScopeType {
  PRODUCT
  BRAND
  DISTRIBUTOR
  CATEGORY
  FAMILY
  GLOBAL
  CLIENT
}

model MarginRule {
  id             String        @id @default(cuid())
  name           String
  priority       Int           @default(100)
  scopeType      RuleScopeType
  scopeId        String?
  clientId       String?
  client         Client?       @relation("ClientMargins", fields: [clientId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  marginPercent  Decimal       @db.Decimal(6, 3)
  isActive       Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([scopeType, scopeId])
  @@index([clientId])
}

model DiscountRule {
  id              String        @id @default(cuid())
  name            String
  priority        Int           @default(100)
  scopeType       RuleScopeType
  scopeId         String?
  clientId        String?
  client          Client?       @relation("ClientDiscounts", fields: [clientId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Decimal       @db.Decimal(6, 3)
  isActive        Boolean       @default(true)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scopeType, scopeId])
  @@index([clientId])
}

model VisibilityRule {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopeType RuleScopeType
  scopeId   String?
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  canView   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, scopeType])
}

// ---------------------------------------------
// CLIENTE: wishlist, listas, solicitudes
// ---------------------------------------------

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Favoritos")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

enum CustomerRequestType {
  QUOTE
  ORDER
  CONSULTATION
}

enum CustomerRequestStatus {
  DRAFT
  SENT
  IN_REVIEW
  ANSWERED
  CONFIRMED
  REJECTED
  CLOSED
}

model CustomerRequest {
  id                  String                 @id @default(cuid())
  clientId            String?
  client              Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                CustomerRequestType    @default(QUOTE)
  status              CustomerRequestStatus  @default(DRAFT)
  projectDescription  String?
  adminResponse       String?
  aiSuggestedResponse String?
  totalEstimateUsd    Decimal?               @db.Decimal(14, 2)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  items    CustomerRequestItem[]
  messages RequestMessage[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model CustomerRequestItem {
  id                String          @id @default(cuid())
  requestId         String
  request           CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int             @default(1)
  selectedOptions   Json?
  userNotes         String?
  adminNotes        String?
  unitPriceUsd      Decimal?        @db.Decimal(14, 4)
  adminAlternativeProductId String?
  // Marca si este ítem es una sugerencia del admin (alternativa propuesta al cliente)
  isAdminSuggestion Boolean         @default(false)
  createdAt         DateTime        @default(now())
}

model RequestMessage {
  id              String   @id @default(cuid())
  requestId       String
  request         CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message         String
  isAiGenerated   Boolean  @default(false)
  attachments     Json?
  createdAt       DateTime @default(now())

  @@index([requestId])
}

// ---------------------------------------------
// LANDING PÚBLICA Y CONTENIDO
// ---------------------------------------------

model LandingPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LandingHero {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------
// CONFIGURACIÓN GLOBAL Y SECRETS
// ---------------------------------------------

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  isSecret    Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ---------------------------------------------
// IA: feedback de contenido generado
// ---------------------------------------------

enum AiFeedbackType {
  PRODUCT_DESCRIPTION
  PRODUCT_NORMALIZATION
  COLUMN_MAPPING
  REQUEST_RESPONSE
  IMAGE_SUGGESTION
}

enum AiFeedbackVerdict {
  CORRECT
  HAS_ERRORS
  UNCLEAR
}

model AiContentFeedback {
  id            String              @id @default(cuid())
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          AiFeedbackType
  refEntity     String              // tabla referida (ej. "Product", "CustomerRequest")
  refId         String
  generatedText String?
  verdict       AiFeedbackVerdict?
  comment       String?
  createdAt     DateTime            @default(now())

  @@index([type, refId])
}

enum TaxonomySuggestionKind {
  CATEGORY
  FAMILY
}

enum TaxonomySuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Sugerencias de IA para asignar categoría/familia a productos (revisión en admin).
model TaxonomySuggestion {
  id            String                   @id @default(cuid())
  kind          TaxonomySuggestionKind
  status        TaxonomySuggestionStatus @default(PENDING)
  productId     String
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  suggestedName String
  // Id en catálogo si la sugerencia coincide con categoría/familia existente.
  targetId      String?
  confidence    Float?
  rationale     String?
  createdAt     DateTime                 @default(now())
  resolvedAt    DateTime?

  @@index([kind, status])
  @@index([productId, kind, status])
}

model AccountMovement {
  id            String            @id @default(cuid())
  clientId      String
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind          AccountMovementKind
  concept       String
  amountUsd     Decimal           @db.Decimal(14, 2)
  dueDate       DateTime?
  paidAt        DateTime?
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([clientId, createdAt])
  @@index([paidAt])
}

// ---------------------------------------------
// CRESTRON HOME COMPATIBLE DEVICES
// ---------------------------------------------

model CrestronHomeDevice {
  id          String   @id @default(cuid())
  modelNumber String
  productName String
  category    String   // "Audio", "Cameras", "Lighting", etc.
  subCategory String?  // "In-Ceiling", "Wireless", etc.
  brand       String?  // "Crestron", "Lutron", "Yale", etc.
  protocol    String?  // "Cresnet", "infiNET EX", "Ethernet"
  notes       String?
  sourceUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([brand])
}

// ---------------------------------------------
// TICKETS AL DESARROLLADOR
// ---------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  products  ProductLabel[]
}

model ProductLabel {
  productId String
  labelId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([productId, labelId])
  @@index([labelId])
}

model DeveloperTicket {
  id          String         @id @default(cuid())
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  attachments Json?
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([priority])
}

// Cache de traducciones para evitar re-llamar a OpenAI por textos ya traducidos.
// key = sha256 de (sourceText + sourceLang + targetLang + context) — único.
model TranslationCache {
  id             String   @id @default(cuid())
  key            String   @unique
  sourceText     String
  sourceLang     String   @default("en")
  targetLang     String   @default("es")
  context        String?  // "product_name" | "spec_label" | "spec_value" | "category" | "short_desc" | "long_desc" | "doc_name"
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([context])
}

// ---------------------------------------------
// COTIZACIONES / PROPUESTAS TÉCNICO-COMERCIALES
// ---------------------------------------------

enum QuoteStatus {
  DRAFT
  IN_REVIEW
  READY
  ISSUED
  SUPERSEDED
  ARCHIVED
}

enum QuoteLayoutKey {
  COMPACT
  STANDARD
  EDITORIAL
}

enum QuoteItemKind {
  PRODUCT
  SERVICE
}

enum QuoteNodeSource {
  MANUAL
  CATALOG_SEARCH
  PASTE
  SUGGESTED
  HISTORICAL_PATTERN
  TEMPLATE
  BRIEF
  CORPORATE
  GENERATED
}

enum QuoteSectionOrigin {
  CORPORATE
  TEMPLATE
  GENERATED
  MANUAL
  PRODUCT
  PROJECT
}

enum QuoteAssetKind {
  PRODUCT
  APPLICATION
  PROJECT
  PLAN
  TECHNICAL
  GENERATED
  CORPORATE
}

enum QuoteTermsSource {
  SYSTEM
  CLIENT_PREVIOUS
  CUSTOM
}

enum QuoteAiCapability {
  CONTEXT_ANALYZER
  CATALOG_RETRIEVER
  HISTORICAL_PATTERNS
  SOLUTION_ASSISTANT
  TECHNICAL_VALIDATOR
  TECHNICAL_WRITER
  COMMERCIAL_EDITOR
  VISUAL_CURATOR
  FINAL_AUDITOR
  BUILD_FROM_BRIEF
  REVISE_NODE
  PLAN_PARSE
  IMAGE_SEARCH
  IMAGE_GENERATE
}

enum QuoteValidationSeverity {
  ERROR
  WARNING
  SUGGESTION
}

model QuoteContentProfile {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  sectionKeys Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      Quote[]
}

model QuoteBlock {
  id           String   @id @default(cuid())
  key          String
  version      Int      @default(1)
  title        String
  category     String
  body         String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([key, version])
}

model Quote {
  id                     String            @id @default(cuid())
  number                 String            @unique
  version                Int               @default(1)
  status                 QuoteStatus       @default(DRAFT)
  reference              String?
  contactName            String?
  clientId               String?
  client                 Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ownerId                String
  owner                  User              @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  layoutKey              QuoteLayoutKey    @default(STANDARD)
  contentProfileId       String?
  contentProfile         QuoteContentProfile? @relation(fields: [contentProfileId], references: [id], onDelete: SetNull)
  alternativesEnabled    Boolean           @default(false)
  showDeliveryColumn     Boolean           @default(true)
  currency               String            @default("USD")
  language               String            @default("es")
  projectType            String?
  brief                  String?           @db.Text
  advancedIntake         Json?
  termsSource            QuoteTermsSource  @default(SYSTEM)
  issuedAt               DateTime?
  issuedById             String?
  issuedBy               User?             @relation("QuoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  pdfBlobUrl             String?
  docxBlobUrl            String?
  xlsxBlobUrl            String?
  supersededById         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  alternatives QuoteAlternative[]
  items        QuoteItem[]
  sections     QuoteSection[]
  assets       QuoteAsset[]
  context      QuoteContext?
  terms        QuoteCommercialTerms?
  validations  QuoteValidation[]
  revisions    QuoteRevision[]
  aiRuns       QuoteAiRun[]
  relations    QuoteRelation[]

  @@index([status])
  @@index([clientId])
  @@index([ownerId])
  @@index([createdAt])
}

model QuoteAlternative {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  key         String  @default("default")
  name        String  @default("Solución")
  purpose     String?
  isDefault   Boolean @default(true)
  sortOrder   Int     @default(0)

  items    QuoteItem[]
  sections QuoteSection[]

  @@unique([quoteId, key])
}

model QuoteItem {
  id                 String          @id @default(cuid())
  quoteId            String
  quote              Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  alternativeId      String?
  alternative        QuoteAlternative? @relation(fields: [alternativeId], references: [id], onDelete: SetNull)
  kind               QuoteItemKind   @default(PRODUCT)
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  serviceType        String?
  quantity           Decimal         @db.Decimal(12, 3)
  unit               String          @default("u")
  description        String          @db.Text
  unitPriceUsd       Decimal         @db.Decimal(14, 4)
  lineTotalUsd       Decimal         @db.Decimal(14, 4)
  priceOverridden    Boolean         @default(false)
  ivaRate            Decimal         @default(21) @db.Decimal(5, 2)
  deliveryKey        String?
  optional           Boolean         @default(false)
  excluded           Boolean         @default(false)
  sortOrder          Int             @default(0)
  source             QuoteNodeSource @default(MANUAL)
  locked             Boolean         @default(false)
  lastInstruction    String?
  lastAiRunId        String?
  quantityRationale  String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([quoteId])
  @@index([productId])
}

model QuoteSection {
  id              String              @id @default(cuid())
  quoteId         String
  quote           Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  alternativeId   String?
  alternative     QuoteAlternative?   @relation(fields: [alternativeId], references: [id], onDelete: SetNull)
  type            String
  title           String
  body            String              @db.Text
  origin          QuoteSectionOrigin  @default(MANUAL)
  source          QuoteNodeSource     @default(MANUAL)
  locked          Boolean             @default(false)
  stale           Boolean             @default(false)
  included        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  sourceBlockKey  String?
  sourceBlockVersion Int?
  dependencyKeys  Json?
  lastInstruction String?
  lastAiRunId     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([quoteId])
}

model QuoteAsset {
  id              String         @id @default(cuid())
  quoteId         String
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind            QuoteAssetKind
  url             String
  caption         String?
  aiGenerated     Boolean        @default(false)
  source          QuoteNodeSource @default(MANUAL)
  locked          Boolean        @default(false)
  lastInstruction String?
  productId       String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
}

model QuoteContext {
  id             String   @id @default(cuid())
  quoteId        String   @unique
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  facts          Json?
  assumptions    Json?
  questions      Json?
  risks          Json?
  spaces         Json?
  notes          String?  @db.Text
  updatedAt      DateTime @updatedAt
}

model QuoteCommercialTerms {
  id                 String           @id @default(cuid())
  quoteId            String           @unique
  quote              Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  pricesIn           String           @default("USD")
  paymentReference   String?
  paymentTerms       String?
  validityDays       Int              @default(5)
  deliveryText       String?
  productWarranty    String?
  installationText   String?
  staffText          String?
  isoText            String?
  closingText        String?
  lockedFields       Json?
  updatedAt          DateTime         @updatedAt
}

model QuoteRelation {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fromItemId String?
  toItemId   String?
  type      String
  status    String  @default("unvalidated")
  evidence  String?
  comment   String?
}

model QuoteValidation {
  id         String                   @id @default(cuid())
  quoteId    String
  quote      Quote                    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rule       String
  severity   QuoteValidationSeverity
  message    String
  nodeId     String?
  status     String                   @default("open")
  resolvedBy String?
  resolution String?
  createdAt  DateTime                 @default(now())
}

model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  summary   String
  snapshot  Json?
  createdAt DateTime @default(now())

  @@index([quoteId])
}

model QuoteAiRun {
  id          String            @id @default(cuid())
  quoteId     String
  quote       Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  capability  QuoteAiCapability
  provider    String?
  model       String?
  nodeId      String?
  instruction String?           @db.Text
  inputHash   String?
  output      Json?
  accepted    Boolean?
  createdAt   DateTime          @default(now())

  @@index([quoteId])
}

model HistoricalQuoteSheet {
  id         String   @id @default(cuid())
  sheetName  String
  sourceFile String   @default("Planillas de Cotizacion 5.0.xlsx")
  projectHint String?
  ingestedAt DateTime @default(now())
  lines      HistoricalQuoteLine[]

  @@index([sheetName])
}

model HistoricalQuoteLine {
  id           String  @id @default(cuid())
  sheetId      String
  sheet        HistoricalQuoteSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  description  String  @db.Text
  quantity     Decimal? @db.Decimal(12, 3)
  unit         String?
  parsedBrand  String?
  parsedModel  String?
  productId    String?
}
